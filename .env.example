# Supabase (https://supabase.com) — online database so your data is available
# on every device. Leave both empty to keep everything in the browser only.
# Find them in Supabase → Project Settings → API Keys. The publishable key
# (called "anon public" in older projects) is safe to expose to the browser:
# Row Level Security (see supabase/schema.sql) protects the data.
# Locally, put them in .env.local; in production, in Vercel's Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Resend (https://resend.com) API key used by api/send-email.ts to send
# welcome / payment confirmation emails to clients. Set this in the
# Vercel project's Environment Variables — it is never exposed to the
# browser (only VITE_-prefixed vars are).
RESEND_API_KEY=

# Optional: verified sender address in Resend, e.g. "Mon Activité <hello@mondomaine.fr>".
# Defaults to Resend's sandbox address (onboarding@resend.dev), which can
# only deliver to your own Resend account email until you verify a domain.
RESEND_FROM_EMAIL=
