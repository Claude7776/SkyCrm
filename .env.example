# Resend (https://resend.com) API key used by api/send-email.ts to send
# welcome / payment confirmation emails to clients. Set this in the
# Vercel project's Environment Variables — it is never exposed to the
# browser (only VITE_-prefixed vars are).
RESEND_API_KEY=

# Optional: verified sender address in Resend, e.g. "Mon Activité <hello@mondomaine.fr>".
# Defaults to Resend's sandbox address (onboarding@resend.dev), which can
# only deliver to your own Resend account email until you verify a domain.
RESEND_FROM_EMAIL=
